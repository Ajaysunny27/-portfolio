<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Ajay Kancherla — SOC Analyst</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
:root{
--bg:#020408;
--surface:#060d14;
--card:#0a1520;
--accent:#00ffe1;
--accent2:#ff3e6c;
--accent3:#7c3aed;
--text:#e2eeff;
--text2:#7a9bb5;
--text3:#2d4a5e;
--border:#0d2235;
--glow-c:rgba(0,255,225,0.15);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
background:var(--bg);
color:var(--text);
font-family:'Rajdhani',sans-serif;
font-size:16px;
overflow-x:hidden;
cursor:none;
}

/* CUSTOM CURSOR */
#cursor{
position:fixed;
width:12px;height:12px;
background:var(--accent);
border-radius:50%;
pointer-events:none;
z-index:99999;
transition:transform 0.1s;
mix-blend-mode:screen;
}
#cursor-ring{
position:fixed;
width:40px;height:40px;
border:1px solid rgba(0,255,225,0.4);
border-radius:50%;
pointer-events:none;
z-index:99998;
transition:transform 0.12s,width 0.2s,height 0.2s;
transform:translate(-50%,-50%);
}

/* CANVAS BG */
#bg-canvas{
position:fixed;
top:0;left:0;
width:100%;height:100%;
z-index:0;
pointer-events:none;
}

/* NAV */
nav{
position:fixed;top:0;left:0;right:0;
z-index:1000;
padding:20px 60px;
display:flex;
align-items:center;
justify-content:space-between;
transition:all 0.4s;
}
nav.scrolled{
background:rgba(2,4,8,0.9);
backdrop-filter:blur(20px);
border-bottom:1px solid var(--border);
}
.nav-logo{
font-family:'Share Tech Mono',monospace;
font-size:22px;
color:var(--accent);
text-decoration:none;
letter-spacing:0.1em;
}
.nav-logo span{color:var(--text2);}
.nav-links{display:flex;gap:40px;list-style:none;}
.nav-links a{
color:var(--text2);
text-decoration:none;
font-size:13px;
letter-spacing:0.15em;
text-transform:uppercase;
font-family:'Share Tech Mono',monospace;
transition:color 0.2s;
position:relative;
}
.nav-links a::after{
content:'';
position:absolute;
bottom:-4px;left:0;
width:0;height:1px;
background:var(--accent);
transition:width 0.3s;
}
.nav-links a:hover{color:var(--accent);}
.nav-links a:hover::after{width:100%;}
.nav-hire{
font-family:'Share Tech Mono',monospace;
font-size:12px;
background:transparent;
border:1px solid var(--accent);
color:var(--accent);
padding:8px 20px;
letter-spacing:0.1em;
text-decoration:none;
transition:all 0.3s;
clip-path:polygon(8px 0%,100% 0%,100% calc(100% - 8px),calc(100% - 8px) 100%,0% 100%,0% 8px);
}
.nav-hire:hover{
background:var(--accent);
color:#000;
}

/* HERO */
#hero{
position:relative;
min-height:100vh;
display:flex;
align-items:center;
padding:0 60px;
z-index:1;
overflow:hidden;
}
.hero-left{max-width:760px;}
.hero-eyebrow{
font-family:'Share Tech Mono',monospace;
font-size:12px;
color:var(--accent);
letter-spacing:0.2em;
text-transform:uppercase;
margin-bottom:24px;
opacity:0;
animation:slideIn 0.6s 0.3s forwards;
}
.hero-eyebrow::before{
content:'> ';
color:var(--text3);
}
.hero-name{
font-size:clamp(56px,10vw,120px);
font-weight:700;
line-height:0.9;
letter-spacing:-0.02em;
margin-bottom:24px;
opacity:0;
animation:slideIn 0.6s 0.5s forwards;
}
.hero-name .line1{
display:block;
background:linear-gradient(135deg,#fff 0%,var(--accent) 100%);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
background-clip:text;
}
.hero-name .line2{
display:block;
color:transparent;
-webkit-text-stroke:1px rgba(0,255,225,0.3);
}
.hero-role{
font-family:'Share Tech Mono',monospace;
font-size:20px;
color:var(--text2);
margin-bottom:32px;
min-height:28px;
opacity:0;
animation:slideIn 0.6s 0.7s forwards;
}
.hero-role .prefix{color:var(--accent3);}
.cursor-blink{
display:inline-block;
width:10px;height:20px;
background:var(--accent);
margin-left:4px;
vertical-align:middle;
animation:blink 0.8s infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
.hero-desc{
font-size:18px;
line-height:1.7;
color:var(--text2);
max-width:560px;
margin-bottom:48px;
opacity:0;
animation:slideIn 0.6s 0.9s forwards;
}
.hero-ctas{
display:flex;gap:16px;
flex-wrap:wrap;
opacity:0;
animation:slideIn 0.6s 1.1s forwards;
}
.btn-primary{
font-family:'Share Tech Mono',monospace;
font-size:13px;
letter-spacing:0.1em;
background:var(--accent);
color:#000;
padding:14px 32px;
text-decoration:none;
font-weight:700;
transition:all 0.3s;
clip-path:polygon(12px 0%,100% 0%,100% calc(100% - 12px),calc(100% - 12px) 100%,0% 100%,0% 12px);
}
.btn-primary:hover{
transform:translateY(-3px);
box-shadow:0 12px 40px rgba(0,255,225,0.3);
}
.btn-secondary{
font-family:'Share Tech Mono',monospace;
font-size:13px;
letter-spacing:0.1em;
border:1px solid var(--border);
color:var(--text);
padding:14px 32px;
text-decoration:none;
transition:all 0.3s;
clip-path:polygon(12px 0%,100% 0%,100% calc(100% - 12px),calc(100% - 12px) 100%,0% 100%,0% 12px);
}
.btn-secondary:hover{
border-color:var(--accent);
color:var(--accent);
transform:translateY(-3px);
}
.hero-right{
position:absolute;
right:60px;top:50%;
transform:translateY(-50%);
display:flex;
flex-direction:column;
gap:32px;
opacity:0;
animation:slideIn 0.6s 1.3s forwards;
}
.hero-stat{text-align:right;}
.hero-stat .val{
font-family:'Share Tech Mono',monospace;
font-size:36px;
color:var(--accent);
line-height:1;
}
.hero-stat .lbl{
font-size:11px;
color:var(--text3);
letter-spacing:0.15em;
text-transform:uppercase;
margin-top:2px;
}
.hero-terminal{
font-family:'Share Tech Mono',monospace;
font-size:12px;
color:var(--text3);
margin-top:48px;
opacity:0;
animation:slideIn 0.6s 1.5s forwards;
}
.hero-terminal .t-prompt{color:var(--accent);}
.hero-terminal .t-cmd{color:var(--text2);}
.hero-terminal .t-ok{color:#00ff88;}

@keyframes slideIn{
from{opacity:0;transform:translateY(30px);}
to{opacity:1;transform:translateY(0);}
}

/* SECTIONS */
section{
position:relative;
z-index:1;
padding:100px 60px;
}
.s-tag{
font-family:'Share Tech Mono',monospace;
font-size:11px;
color:var(--accent);
letter-spacing:0.2em;
text-transform:uppercase;
margin-bottom:8px;
}
.s-tag::before{content:'// ';}
.s-title{
font-size:clamp(36px,5vw,56px);
font-weight:700;
letter-spacing:-0.02em;
margin-bottom:64px;
line-height:1.05;
}
.s-title .hl{color:var(--accent);}

/* ABOUT */
#about{background:var(--surface);}
.about-wrap{
display:grid;
grid-template-columns:1fr 1fr;
gap:80px;
align-items:start;
}
.about-text{
font-size:17px;
line-height:1.9;
color:var(--text2);
}
.about-text p{margin-bottom:20px;}
.about-text strong{color:var(--accent);}
.open-badge{
display:inline-flex;
align-items:center;
gap:10px;
border:1px solid rgba(0,255,225,0.2);
background:rgba(0,255,225,0.05);
padding:10px 20px;
margin-top:24px;
font-family:'Share Tech Mono',monospace;
font-size:12px;
color:var(--accent);
letter-spacing:0.08em;
}
.badge-dot{
width:8px;height:8px;
border-radius:50%;
background:var(--accent);
animation:pls 2s infinite;
}
@keyframes pls{
0%,100%{box-shadow:0 0 0 0 rgba(0,255,225,0.4);}
50%{box-shadow:0 0 0 8px rgba(0,255,225,0);}
}
.about-cards{
display:grid;
grid-template-columns:1fr 1fr;
gap:16px;
}
.acard{
background:var(--card);
border:1px solid var(--border);
padding:24px;
transition:all 0.4s;
clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,0 100%);
}
.acard:hover{
border-color:rgba(0,255,225,0.3);
box-shadow:0 0 30px var(--glow-c);
transform:translateY(-6px);
}
.acard .ico{font-size:28px;margin-bottom:12px;}
.acard .ttl{
font-size:14px;
font-weight:700;
color:var(--accent);
letter-spacing:0.1em;
text-transform:uppercase;
margin-bottom:6px;
}
.acard .val{font-size:15px;color:var(--text2);}

/* EXPERIENCE */
#experience{background:var(--bg);}
.exp-wrap{position:relative;padding-left:40px;}
.exp-wrap::before{
content:'';
position:absolute;
left:0;top:0;bottom:0;
width:1px;
background:linear-gradient(to bottom,var(--accent),transparent);
}
.exp-item{position:relative;margin-bottom:56px;}
.exp-item::before{
content:'';
position:absolute;
left:-44px;top:8px;
width:8px;height:8px;
border-radius:50%;
background:var(--accent);
box-shadow:0 0 16px var(--accent);
}
.exp-header{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:24px;
margin-bottom:16px;
}
.exp-co{
display:flex;
align-items:center;
gap:16px;
}
.exp-logo{
width:48px;height:48px;
background:var(--accent);
color:#000;
display:flex;
align-items:center;
justify-content:center;
font-weight:700;
font-size:18px;
clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,0 100%);
}
.exp-role{font-size:20px;font-weight:700;color:var(--text);}
.exp-company{font-family:'Share Tech Mono',monospace;font-size:13px;color:var(--accent);}
.exp-date{
font-family:'Share Tech Mono',monospace;
font-size:11px;
color:var(--text3);
letter-spacing:0.1em;
white-space:nowrap;
padding-top:6px;
}
.exp-list{list-style:none;padding:0;}
.exp-list li{
padding:7px 0 7px 20px;
position:relative;
font-size:15px;
color:var(--text2);
line-height:1.6;
}
.exp-list li::before{
content:'▸';
position:absolute;
left:0;
color:var(--accent);
font-size:10px;
top:10px;
}

/* SKILLS */
#skills{background:var(--surface);}
.skills-top{
display:grid;
grid-template-columns:1fr 1fr;
gap:40px;
margin-bottom:40px;
}
.skill-bar-wrap{margin-bottom:20px;}
.skill-bar-head{
display:flex;
justify-content:space-between;
font-size:14px;
color:var(--text2);
margin-bottom:8px;
}
.skill-track{
height:2px;
background:var(--border);
}
.skill-fill{
height:100%;
background:linear-gradient(90deg,var(--accent),var(--accent3));
width:0;
transition:width 1.4s cubic-bezier(0.4,0,0.2,1);
}
.skills-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
}
.scard{
background:var(--card);
border:1px solid var(--border);
padding:28px;
transition:all 0.4s;
clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,0 100%);
}
.scard:hover{
border-color:rgba(0,255,225,0.2);
box-shadow:0 0 40px var(--glow-c);
transform:translateY(-6px);
}
.scard-title{
font-family:'Share Tech Mono',monospace;
font-size:11px;
color:var(--accent);
letter-spacing:0.15em;
text-transform:uppercase;
margin-bottom:16px;
padding-bottom:12px;
border-bottom:1px solid var(--border);
}
.pills{display:flex;flex-wrap:wrap;gap:8px;}
.pill{
font-family:'Share Tech Mono',monospace;
font-size:11px;
padding:4px 12px;
border:1px solid var(--border);
color:var(--text2);
transition:all 0.2s;
}
.pill:hover{border-color:var(--accent);color:var(--accent);}
.pill.hot{border-color:rgba(0,255,225,0.3);color:var(--accent);background:rgba(0,255,225,0.05);}

/* PROJECTS */
#projects{background:var(--bg);}
.proj-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(360px,1fr));
gap:24px;
}
.pcard{
background:var(--card);
border:1px solid var(--border);
padding:36px;
position:relative;
overflow:hidden;
transition:all 0.4s;
transform-style:preserve-3d;
clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));
}
.pcard::after{
content:'';
position:absolute;
inset:0;
background:linear-gradient(135deg,transparent 60%,rgba(0,255,225,0.03) 100%);
pointer-events:none;
}
.pcard:hover{
border-color:rgba(0,255,225,0.25);
box-shadow:
0 30px 60px rgba(0,0,0,0.5),
0 0 60px var(--glow-c),
inset 0 0 60px rgba(0,255,225,0.02);
}
.pcard-top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:24px;
}
.pcard-ico{
width:56px;height:56px;
background:rgba(0,255,225,0.08);
border:1px solid rgba(0,255,225,0.15);
display:flex;
align-items:center;
justify-content:center;
font-size:26px;
clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,0 100%);
}
.pcard-link{
font-family:'Share Tech Mono',monospace;
font-size:12px;
color:var(--accent);
text-decoration:none;
border:1px solid rgba(0,255,225,0.2);
padding:6px 14px;
transition:all 0.2s;
}
.pcard-link:hover{background:rgba(0,255,225,0.1);}
.pcard-flag{
font-family:'Share Tech Mono',monospace;
font-size:10px;
color:var(--accent);
background:rgba(0,255,225,0.08);
border:1px solid rgba(0,255,225,0.15);
padding:3px 12px;
letter-spacing:0.1em;
display:inline-block;
margin-bottom:12px;
}
.pcard h3{
font-size:24px;
font-weight:700;
margin-bottom:12px;
color:var(--text);
}
.pcard p{
font-size:14px;
color:var(--text2);
line-height:1.8;
margin-bottom:24px;
}
.ptags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;}
.ptag{
font-family:'Share Tech Mono',monospace;
font-size:10px;
padding:4px 10px;
border:1px solid rgba(0,255,225,0.12);
color:rgba(0,255,225,0.7);
background:rgba(0,255,225,0.04);
}

/* CERTS */
#certifications{background:var(--surface);}
.cert-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:16px;
margin-bottom:48px;
}
.cert-card{
background:var(--card);
border:1px solid var(--border);
padding:20px 24px;
display:flex;
align-items:center;
gap:16px;
transition:all 0.3s;
}
.cert-card:hover{
border-color:rgba(0,255,225,0.2);
transform:translateY(-4px);
box-shadow:0 16px 40px rgba(0,0,0,0.3);
}
.cert-ico{
width:44px;height:44px;
background:rgba(0,255,225,0.08);
border:1px solid rgba(0,255,225,0.15);
display:flex;align-items:center;justify-content:center;
font-size:18px;flex-shrink:0;
}
.cert-name{font-size:14px;font-weight:700;color:var(--text);margin-bottom:2px;}
.cert-iss{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--text3);margin-bottom:4px;}
.cert-badge{
font-family:'Share Tech Mono',monospace;
font-size:10px;
padding:2px 8px;
display:inline-block;
}
.cert-badge.done{background:rgba(0,255,136,0.1);color:#00ff88;border:1px solid rgba(0,255,136,0.2);}
.cert-badge.wip{background:rgba(255,62,108,0.1);color:var(--accent2);border:1px solid rgba(255,62,108,0.2);}
.edu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;}
.edu-card{
background:var(--card);
border:1px solid var(--border);
padding:24px;
transition:all 0.3s;
clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,0 100%);
}
.edu-card:hover{border-color:rgba(0,255,225,0.2);transform:translateY(-4px);}
.edu-deg{font-size:16px;font-weight:700;margin-bottom:4px;}
.edu-sch{font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--accent);margin-bottom:4px;}
.edu-yr{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--text3);}

/* CONTACT */
#contact{background:var(--bg);text-align:center;}
.contact-head{
font-size:clamp(28px,5vw,52px);
font-weight:700;
letter-spacing:-0.02em;
margin-bottom:16px;
}
.contact-sub{
font-size:16px;
color:var(--text2);
max-width:500px;
margin:0 auto 48px;
}
.contact-email{
font-family:'Share Tech Mono',monospace;
font-size:22px;
color:var(--accent);
text-decoration:none;
display:inline-block;
margin-bottom:48px;
border-bottom:1px solid rgba(0,255,225,0.2);
padding-bottom:4px;
transition:border-color 0.2s;
}
.contact-email:hover{border-color:var(--accent);}
.socials{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;}
.soc-link{
font-family:'Share Tech Mono',monospace;
font-size:12px;
letter-spacing:0.1em;
border:1px solid var(--border);
color:var(--text2);
padding:12px 24px;
text-decoration:none;
transition:all 0.3s;
clip-path:polygon(8px 0%,100% 0%,100% calc(100% - 8px),calc(100% - 8px) 100%,0% 100%,0% 8px);
}
.soc-link:hover{border-color:var(--accent);color:var(--accent);}

/* FOOTER */
footer{
background:var(--surface);
border-top:1px solid var(--border);
padding:24px 60px;
display:flex;
justify-content:space-between;
align-items:center;
flex-wrap:wrap;
gap:8px;
}
footer span{font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--text3);}
footer .a{color:var(--accent);}

/* FADE UP */
.fu{
opacity:0;
transform:translateY(40px);
transition:opacity 0.7s ease,transform 0.7s ease;
}
.fu.vis{opacity:1;transform:translateY(0);}
.fu-d1{transition-delay:0.1s;}
.fu-d2{transition-delay:0.2s;}
.fu-d3{transition-delay:0.3s;}
.fu-d4{transition-delay:0.4s;}

/* MOBILE */
@media(max-width:768px){
nav{padding:16px 24px;}
.nav-links{display:none;}
section{padding:64px 24px;}
#hero{padding:80px 24px 40px;}
.hero-right{position:static;transform:none;margin-top:48px;flex-direction:row;flex-wrap:wrap;gap:24px;}
.hero-stat{text-align:left;}
.about-wrap{grid-template-columns:1fr;}
.skills-top{grid-template-columns:1fr;}
footer{padding:24px;}
.exp-header{flex-direction:column;}
}

/* GLITCH */
.glitch{
position:relative;
display:inline-block;
}
.glitch::before,.glitch::after{
content:attr(data-text);
position:absolute;
top:0;left:0;
width:100%;
}
.glitch::before{
color:var(--accent2);
animation:glitch1 4s infinite;
clip-path:polygon(0 20%,100% 20%,100% 40%,0 40%);
}
.glitch::after{
color:var(--accent);
animation:glitch2 4s infinite;
clip-path:polygon(0 60%,100% 60%,100% 80%,0 80%);
}
@keyframes glitch1{
0%,90%,100%{transform:translate(0);}
92%{transform:translate(-3px,1px);}
94%{transform:translate(3px,-1px);}
96%{transform:translate(-2px,2px);}
98%{transform:translate(2px,-2px);}
}
@keyframes glitch2{
0%,90%,100%{transform:translate(0);}
91%{transform:translate(3px,2px);}
93%{transform:translate(-3px,-1px);}
95%{transform:translate(2px,1px);}
97%{transform:translate(-2px,-2px);}
}
</style>
</head>
<body>

<div id="cursor"></div>
<div id="cursor-ring"></div>
<canvas id="bg-canvas"></canvas>

<!-- NAV -->
<nav id="nav">
  <a href="#hero" class="nav-logo">AK<span>.SOC</span></a>
  <ul class="nav-links">
    <li><a href="#about">ABOUT</a></li>
    <li><a href="#experience">EXPERIENCE</a></li>
    <li><a href="#skills">SKILLS</a></li>
    <li><a href="#projects">PROJECTS</a></li>
    <li><a href="#certifications">CERTS</a></li>
    <li><a href="#contact">CONTACT</a></li>
