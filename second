<script>
// ── CURSOR ──
const cur=document.getElementById('cur'),ring=document.getElementById('cur-ring');
let mx=window.innerWidth/2,my=window.innerHeight/2,rx=mx,ry=my;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
(function animRing(){rx+=(mx-rx)*.1;ry+=(my-ry)*.1;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(animRing);})();
document.querySelectorAll('a,button,.pc,.ac,.cc,.ec').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cur.classList.add('big');ring.classList.add('big');});
  el.addEventListener('mouseleave',()=>{cur.classList.remove('big');ring.classList.remove('big');});
});

// ── CANVAS NEURAL BG ──
const C=document.getElementById('bgc'),X=C.getContext('2d');
let W,H;
function rsz(){W=C.width=window.innerWidth;H=C.height=window.innerHeight;}
rsz();window.addEventListener('resize',rsz);
const NS=[];for(let i=0;i<80;i++)NS.push({x:Math.random()*window.innerWidth,y:Math.random()*window.innerHeight,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35,r:Math.random()*1.5+.5});
let mouse={x:-999,y:-999};
document.addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY;});
(function drawBG(){
  X.clearRect(0,0,W,H);
  NS.forEach(n=>{
    n.x+=n.vx;n.y+=n.vy;
    if(n.x<0||n.x>W)n.vx*=-1;if(n.y<0||n.y>H)n.vy*=-1;
    const dx=n.x-mouse.x,dy=n.y-mouse.y,d=Math.sqrt(dx*dx+dy*dy);
    if(d<150){n.x+=dx/d*1.2;n.y+=dy/d*1.2;}
    X.beginPath();X.arc(n.x,n.y,n.r,0,Math.PI*2);X.fillStyle='rgba(0,255,225,0.45)';X.fill();
  });
  NS.forEach((a,i)=>NS.slice(i+1).forEach(b=>{
    const dx=a.x-b.x,dy=a.y-b.y,d=Math.sqrt(dx*dx+dy*dy);
    if(d<140){X.beginPath();X.moveTo(a.x,a.y);X.lineTo(b.x,b.y);X.strokeStyle=`rgba(0,255,225,${.1*(1-d/140)})`;X.lineWidth=.5;X.stroke();}
  }));
  requestAnimationFrame(drawBG);
})();

// ── NAV ──
window.addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('sc',scrollY>60));

// ── TYPEWRITER ──
const roles=['SOC Analyst','Threat Detection Engineer','Security Automation Builder','AI + Cybersecurity'];
let ri=0,ci=0,del=false;
const tw=document.getElementById('tw');
(function type(){
  const r=roles[ri];
  del?tw.textContent=r.substring(0,--ci):tw.textContent=r.substring(0,++ci);
  if(!del&&ci===r.length){setTimeout(()=>del=true,2000);return;}
  if(del&&ci===0){del=false;ri=(ri+1)%roles.length;}
  setTimeout(type,del?55:105);
})();

// ── FADE UP OBSERVER ──
const fo=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add('vis');
      e.target.querySelectorAll('.skill-fill').forEach(f=>f.style.width=f.dataset.w+'%');
    }
  });
},{threshold:.1});
document.querySelectorAll('.fu').forEach(el=>fo.observe(el));

// ── HEX GRID ANIMATE ──
const hexObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.hi').forEach((item,i)=>{
        setTimeout(()=>{
          item.style.opacity='1';
          item.style.transform='translateY(0)';
          const lv=parseInt(item.dataset.level);
          item.querySelector('.hi-fill').style.width=(lv/100*50)+'px';
        },i*60);
      });
    }
  });
},{threshold:.1});
document.querySelectorAll('.hex-grid').forEach(g=>{
  g.querySelectorAll('.hi').forEach(item=>{
    item.style.transition='opacity .5s ease,transform .5s ease,background .4s,border-color .4s,box-shadow .4s';
  });
  hexObs.observe(g);
});

// ── 3D TILT on project cards ──
document.querySelectorAll('.pc').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    const x=e.clientX-r.left,y=e.clientY-r.top;
    const rX=((y-r.height/2)/r.height)*-14;
    const rY=((x-r.width/2)/r.width)*14;
    card.style.transform=`perspective(900px) rotateX(${rX}deg) rotateY(${rY}deg) translateY(-8px) scale(1.02)`;
    card.style.boxShadow=`${-rY*2}px ${rX*2}px 60px rgba(0,0,0,.5),0 0 80px rgba(0,255,225,.12)`;
  });
  card.addEventListener('mouseleave',()=>{
    card.style.transform='perspective(900px) rotateX(0) rotateY(0) translateY(0) scale(1)';
    card.style.boxShadow='';
  });
});

// ── 3D TILT on about cards ──
document.querySelectorAll('.ac,.cc').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    const rX=((e.clientY-r.top-r.height/2)/r.height)*-10;
    const rY=((e.clientX-r.left-r.width/2)/r.width)*10;
    card.style.transform=`perspective(600px) rotateX(${rX}deg) rotateY(${rY}deg) translateY(-6px)`;
  });
  card.addEventListener('mouseleave',()=>card.style.transform='');
});

// ── RADAR CHART ──
const rc=document.getElementById('radar');
if(rc){
  const rx2=rc.getContext('2d');
  const cx=200,cy=200,rad=150;
  const skills=[
    {v:.85},{v:.80},{v:.72},{v:.70},{v:.65},{v:.75}
  ];
  const n=skills.length;
  function pt(i,val,r){
    const a=(Math.PI*2*i/n)-Math.PI/2;
    return{x:cx+Math.cos(a)*r*val,y:cy+Math.sin(a)*r*val};
  }
  function drawR(p){
    rx2.clearRect(0,0,400,400);
    // rings
    [.25,.5,.75,1].forEach(ring=>{
      rx2.beginPath();
      for(let i=0;i<n;i++){const pt2=pt(i,ring,rad);i===0?rx2.moveTo(pt2.x,pt2.y):rx2.lineTo(pt2.x,pt2.y);}
      rx2.closePath();rx2.strokeStyle='rgba(0,255,225,0.08)';rx2.lineWidth=1;rx2.stroke();
    });
    // axes
    for(let i=0;i<n;i++){
      const pt2=pt(i,1,rad);
      rx2.beginPath();rx2.moveTo(cx,cy);rx2.lineTo(pt2.x,pt2.y);
      rx2.strokeStyle='rgba(0,255,225,0.1)';rx2.lineWidth=1;rx2.stroke();
    }
    // fill
    rx2.beginPath();
    skills.forEach((s,i)=>{const pt2=pt(i,s.v*p,rad);i===0?rx2.moveTo(pt2.x,pt2.y):rx2.lineTo(pt2.x,pt2.y);});
    rx2.closePath();rx2.fillStyle='rgba(0,255,225,0.07)';rx2.fill();
    rx2.strokeStyle='rgba(0,255,225,0.6)';rx2.lineWidth=2;rx2.stroke();
    // dots
    skills.forEach((s,i)=>{
      const pt2=pt(i,s.v*p,rad);
      rx2.beginPath();rx2.arc(pt2.x,pt2.y,5,0,Math.PI*2);rx2.fillStyle='#00ffe1';rx2.fill();
      rx2.beginPath();rx2.arc(pt2.x,pt2.y,9,0,Math.PI*2);rx2.strokeStyle='rgba(0,255,225,0.3)';rx2.lineWidth=1;rx2.stroke();
    });
  }
  const ro=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        let p=0;
        (function anim(){p+=.018;drawR(Math.min(p,1));if(p<1)requestAnimationFrame(anim);})();
      }
    });
  },{threshold:.3});
  ro.observe(rc);
}
</script>
